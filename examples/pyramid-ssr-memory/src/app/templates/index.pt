<!DOCTYPE html>
<html lang="en" xmlns:tal="http://xml.zope.org/namespaces/tal">
  <head>
    <meta charset="utf-8" />
    <title>Todo List</title>
  </head>
  <body>
    <h1>Todo List</h1>

    <p tal:condition="python:error" role="alert" tal:content="python:error">error</p>

    <form method="post" action="/todos">
      <label for="title">New todo</label>
      <input id="title" name="title" type="text" required="required" />
      <button type="submit">Add</button>
    </form>

    <ul>
      <li tal:condition="python:not todos">No todos yet.</li>
      <li tal:repeat="todo python:todos">
        <span tal:content="python:todo.title">title</span>
        <span tal:condition="python:todo.done">done</span>
        <span tal:condition="python:not todo.done">not done</span>
        <form method="post" tal:attributes="python:{'action': '/todos/%s/toggle' % todo.id}">
          <button tal:condition="python:todo.done" type="submit">Mark not done</button>
          <button tal:condition="python:not todo.done" type="submit">Mark done</button>
        </form>
        <form method="post" tal:attributes="python:{'action': '/todos/%s/delete' % todo.id}">
          <button type="submit">Delete</button>
        </form>
      </li>
    </ul>
  </body>
</html>
